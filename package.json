{
  "name": "finflow",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "client": "bun run --bun astro dev",
    "build:client": "bun run --bun astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint 'src/**/*.{js,ts,tsx,astro}'",
    "worker": "wrangler dev",
    "dev": "concurrently \"bun run client\" \"bun run worker\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply finflow_local_db --local"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.16",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.7",
    "jose": "^6.1.3",
    "resend": "^6.9.1",
    "tailwindcss": "^4.1.18",
    "wrangler": "^4.61.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260128.0",
    "@types/bun": "^1.3.7",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-seed": "^0.3.1",
    "eslint-plugin-astro": "^1.5.0",
    "eslint": "^9.39.2"
  }
}
